{
  "sourceLanguage" : "en",
  "strings" : {
    " -> " : {
      "comment" : "A separator between a player's name and the player they voted for.",
      "isCommentAutoGenerated" : true
    },
    "--" : {
      "comment" : "A placeholder value for a countdown timer.",
      "isCommentAutoGenerated" : true
    },
    "#%lld" : {
      "comment" : "A label showing the player's ranking in a round. The argument is the player's ranking.",
      "isCommentAutoGenerated" : true
    },
    "%@ %lld · %lld/%lld" : {
      "comment" : "A label that shows the round number and the current question number and total number of questions in that round. The first argument is the string “round.summary.title”. The second argument is the current question number. The third argument is the total number of questions in that round.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$lld · %3$lld/%4$lld"
          }
        }
      }
    },
    "%@ +%lld" : {
      "comment" : "A list of users who voted for a drawing.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ +%2$lld"
          }
        }
      }
    },
