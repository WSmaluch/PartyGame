{
  "sourceLanguage" : "en",
  "strings" : {
    " -> " : {
      "comment" : "A separator between a player's name and the player they voted for.",
      "isCommentAutoGenerated" : true
    },
    "--" : {
      "comment" : "A placeholder value for a countdown timer.",
      "isCommentAutoGenerated" : true
    },
    "#%lld" : {
      "comment" : "A label showing the player's ranking in a round. The argument is the player's ranking.",
      "isCommentAutoGenerated" : true
    },
    "%@, %@" : {
      "comment" : "A label that combines a player's nickname with their readiness status.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A row in the host game settings view. The argument is a localized string key, the second is an integer.",
      "isCommentAutoGenerated" : true
    },
    "%lld pts" : {
      "comment" : "A label displaying the score of a player in a game round.",
      "isCommentAutoGenerated" : true
    },
