<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PartyGame.Domain\PartyGame.Domain.csproj" />
    <ProjectReference Include="..\PartyGame.GameEngine\PartyGame.GameEngine.csproj" />
    <ProjectReference Include="..\PartyGame.Infrastructure\PartyGame.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.8.1</Version>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">unknown</SourceRevisionId>
    <PartyGameBuildTimestampUtc Condition="'$(PartyGameBuildTimestampUtc)' == ''">unknown</PartyGameBuildTimestampUtc>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CommitHash" Value="$(SourceRevisionId)" />
    <AssemblyMetadata Include="BuildTimestampUtc" Value="$(PartyGameBuildTimestampUtc)" />
  </ItemGroup>

</Project>
