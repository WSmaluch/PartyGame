<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.partygame.server</string>
  <key>ProgramArguments</key><array>
    <string>{{INSTALL_ROOT}}/scripts/start.sh</string>
    <string>--deploy-root</string><string>{{INSTALL_ROOT}}</string>
    <string>--runtime-root</string><string>{{RUNTIME_ROOT}}</string>
    <string>--host</string><string>{{HOST}}</string>
    <string>--port</string><string>{{PORT}}</string>
  </array>
  <key>WorkingDirectory</key><string>{{INSTALL_ROOT}}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
</dict></plist>
