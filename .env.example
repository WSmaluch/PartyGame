# PartyGame release runtime contract. Copy to your process manager or deployment environment;
# this file contains no secrets and is not loaded automatically by the API.
ASPNETCORE_ENVIRONMENT=Production
PARTYGAME_URLS=http://0.0.0.0:5050
PARTYGAME_DATABASE_PATH=/var/lib/partygame/partygame.db
PARTYGAME_MEDIA_ROOT=/var/lib/partygame/media
PARTYGAME_PUBLIC_BASE_URL=http://192.168.1.50:5050
PARTYGAME_ALLOWED_ORIGINS=http://192.168.1.50:5173,http://192.168.1.50:5174
PARTYGAME_DISPLAY_PUBLIC_URL=http://192.168.1.50:5173/display
PARTYGAME_ADMIN_PUBLIC_URL=http://192.168.1.50:5174/admin
PARTYGAME_LOG_LEVEL=Information
# Required in Production for /api/admin operations. Generate a random value of at least 32 characters.
PARTYGAME_OPERATOR_TOKEN=REPLACE_WITH_A_RANDOM_OPERATOR_TOKEN_AT_LEAST_32_CHARACTERS

# Production HTTP is disabled unless this is explicitly set to true. Use HTTPS
# instead whenever the deployment is not confined to a trusted private LAN.
PARTYGAME_ALLOW_INSECURE_LAN_HTTP=false
# Enable only on an HTTPS endpoint after the certificate and redirect are verified.
PARTYGAME_ENABLE_HSTS=false
# Set only for a disposable first-run smoke runtime. Production migration policy is stage 8.3.
PARTYGAME_APPLY_MIGRATIONS=false
